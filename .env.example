# Required for production builds (set these in your host's environment variables).
# The build fails if VITE_EDITOR_URL is missing or points at localhost.
VITE_EDITOR_URL=https://app.example.com

# Google Apps Script web app URL that appends to the waitlist sheet.
# Setup: docs/waitlist-google-sheet.md
VITE_WAITLIST_ENDPOINT=https://script.google.com/macros/s/XXXXXXXX/exec
